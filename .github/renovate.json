{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "packageRules": [
    {
      "description": "The post-publication workflow owns LRCGET version updates.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "tranxuanthang/lrcget"
      ],
      "enabled": false
    }
  ]
}
